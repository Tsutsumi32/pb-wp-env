{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "custom-block/description-list",
  "version": "1.0.1",
  "title": "説明リスト",
  "category": "custom-block",
  "icon": "editor-ul",
  "description": "dt/dd の説明コンテンツ。各項目は div で囲んで表示します。",
  "keywords": ["説明", "dl", "dt", "dd", "定義リスト"],
  "textdomain": "custom-block",
  "editorScript": "file:./editor.js",
  "attributes": {
    "items": {
      "type": "array",
      "default": [
        {
          "id": "",
          "term": "",
          "description": ""
        }
      ]
    }
  },
  "supports": {
    "html": false,
    "multiple": true
  }
}
