{
  "name": "app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "meta:convert-images": "node node/convert-images/meta-generate-convert-images.js",
    "build:convert-images": "node node/convert-images/build-convert-images.js",
    "watch:convert-images": "run-s meta:convert-images && node node/convert-images/watch-convert-images.js",
    "build:scss": "node node/scss/build-scss.js",
    "watch:scss": "node node/scss/watch-scss.js",
    "build:scss-index": "node node/scss-index/build-scss-index.js",
    "watch:scss-index": "node node/scss-index/watch-scss-index.js",
    "build:js": "node node/js/build-js.js",
    "watch:js": "node node/js/watch-js.js",
    "serve": "node node/serve/browser-sync.js",
    "build": "run-s build:scss-index build:scss build:js build:convert-images",
    "watch": "concurrently \"npm run watch:scss-index\" \"npm run watch:scss\" \"npm run watch:js\" \"npm run watch:convert-images\"",
    "dev": "concurrently \"npm run watch\" \"npm run serve\"",
    "format": "prettier --write \"wp-dir/wp-content/themes/*/src/**/*.{js,scss}\"",
    "format:check": "prettier --check \"wp-dir/wp-content/themes/*/src/**/*.{js,scss}\"",
    "lint": "eslint --no-warn-ignored \"wp-dir/wp-content/themes/*/src/js/**/*.js\"",
    "lint:fix": "eslint --fix --no-warn-ignored \"wp-dir/wp-content/themes/*/src/js/**/*.js\"",
    "test:e2e": "playwright test",
    "capture:page": "node node/page-capture/capture-page.js",
    "capture:all": "node node/page-capture/capture-all.js",
    "capture:commands": "node node/page-capture/write-capture-commands.js"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@playwright/test": "^1.56.1",
    "@prettier/plugin-php": "^0.24.0",
    "autoprefixer": "^10.4.21",
    "babel-plugin-polyfill-corejs3": "^0.13.0",
    "browser-sync": "^3.0.4",
    "chokidar": "^4.0.3",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^9.2.1",
    "cssnano": "^7.0.6",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "exceljs": "^4.4.0",
    "fs-extra": "^11.3.0",
    "globals": "^16.5.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "prettier": "^3.6.2",
    "sass": "^1.93.3",
    "sharp": "^0.34.4",
    "terser": "^5.44.1"
  },
  "dependencies": {
    "core-js": "^3.46.0",
    "gsap": "^3.15.0",
    "whatwg-fetch": "^3.6.20"
  }
}
