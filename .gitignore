resources/wp-dir/wp-content/themes/*
!resources/wp-dir/wp-content/themes/sample-hp/

# 本番インポートデータのみ除外（sample / .dev / 画像 / README 等は管理対象）
resources/wp-dir/wp-content/themes/**/data/**/posts.json
resources/wp-dir/wp-content/themes/**/data/**/posts.csv

