# NAME
PROJECT_NAME=sample
# ENV(local, stage, prod)
APP_ENV=local

DB_ROOT_PASSWORD=sample_pass
DB_DATABASE=sample-hp_db
DB_USERNAME=sample-hp
DB_PASSWORD=sample-hp_dbpass
DB_HOST=db:3306

# local adress（ex: localhost)
# WordPress アドレス (URL)・サイトアドレス (URL)の設定も変更
LOCAL_ADDRESS=localhost
# local server port（ex: 8000)
LOCAL_SERVER_PORT=8000
# local db port（ex: 3306)
LOCAL_DB_PORT=3306
# local phpMyAdmin port（ex: 3333)
LOCAL_PHPMYADMIN_PORT=3333

# ホストUID・GID（自身のホスト環境の値に設定する ※make initで自動設定）
HOST_UID=1000
HOST_GID=1000

# frontend port
FRONT_PORT=3000
# frontend container
FRONT_CONTAINER=frontend

# mailhog ports
MAILHOG_UI_PORT=8025
MAILHOG_SMTP_PORT=1025

# vnu port
VNU_PORT=8888

# wp siteurl と home を上書きする
# ブラウザシンク使用する場合はFRONT_PORTを。通常時はLOCAL_SERVER_PORTを使用
#WP_CHAGE_PORT=${LOCAL_SERVER_PORT}
WP_CHAGE_PORT=${FRONT_PORT}

# wp theme名
WP_THEME_NAME=sample-hp
# wp siteタイトル
WP_SITE_TITLE=株式会社サンプル
# wp subディレクトリ
WP_SUB_DIR=wp-dir
# wp ディレクトリまでのパス（コンテナ内）
WP_DIR_PATH=/var/www/html/${WP_SUB_DIR}

# wp 管理者ユーザー（LOCAL）
# 既存ユーザー更新時: 空にした項目は上書きしない（パスワードだけ変更する等）
# 同環境でログイン名変更時: OLD に変更前のログイン名を指定し、NAME_LOCAL に変更後を指定
WP_ADMIN_USER_NAME_LOCAL='adminUser'
# WP_ADMIN_USER_NAME_LOCAL_OLD=
WP_ADMIN_USER_PASS_LOCAL='adminPass'
WP_ADMIN_USER_MAIL_LOCAL='admin@example.com'
# WordPress本体の管理者メールアドレス（LOCAL）
WP_ADMIN_MAIL_LOCAL='wpadmin@example.com'

# wp 管理者ユーザー（PRODUCTION）
WP_ADMIN_USER_NAME_PRODUCTION='adminUserProduction'
# WP_ADMIN_USER_NAME_PRODUCTION_OLD=
WP_ADMIN_USER_PASS_PRODUCTION='adminPassProduction'
WP_ADMIN_USER_MAIL_PRODUCTION='production-user@example.com'
# WordPress本体の管理者メールアドレス（PRODUCTION）
WP_ADMIN_MAIL_PRODUCTION='production-admin@example.com'

# wordpress container name
WP_CONTAINER=wordpress

# .envまでのパス（コンテナ内）
ENV_DIR_PATH=/var/www

# WP Mail SMTP（make wp-config-smtp で wp-config.php に書き込み → 本番へ手動アップロード）
# ローカル開発では WPMS_DISABLE_WP_MAIL_SMTP=true により SMTP 無効（MailHog で確認）
# ローカル専用: true のとき wp-config の SMTP 定数を無効化（本番では環境変数なしのため影響なし）
WPMS_DISABLE_WP_MAIL_SMTP=true
# SMTP サーバーのホスト名
WPMS_SMTP_HOST='smtp.example.com'
# 接続ポート（587=STARTTLS, 465=SSL が一般的）
WPMS_SMTP_PORT=587
# 暗号化方式: tls（587向け）| ssl（465向け）| 空=なし
WPMS_SSL=tls
# SMTP 認証を使うか（契約 SMTP では通常 true）
WPMS_SMTP_AUTH=true
# SMTP ログインユーザー名（多くの場合メールアドレス）
WPMS_SMTP_USER='your-smtp-user'
# SMTP ログインパスワード（wp-config.php に平文で書き込まれるため取り扱い注意）
WPMS_SMTP_PASS='your-smtp-password'
# 接続時に自動で TLS 交渉を試みるか
WPMS_SMTP_AUTOTLS=true
# SMTP 側で送信元を固定する場合のみ設定（functions.php の wp-mail-smtp-sender.php 読み込みをコメントアウトすること）
#WPMS_MAIL_FROM=admin-sender@sample.com
#WPMS_MAIL_FROM_NAME=${WP_THEME_NAME}
